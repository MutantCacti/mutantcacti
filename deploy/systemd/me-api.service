[Unit]
Description=shelf.mutantcacti.com API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/shelf/api
Environment="PATH=/var/www/shelf/api/.venv/bin"
ExecStart=/var/www/shelf/api/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
